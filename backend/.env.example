# Copy to backend/.env (untracked). Values come from the Neon console or
# `neonctl connection-string dev --pooled`, and Settings > Better Auth.

# Pooled connection string for the Neon branch you are working against.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Managed Better Auth URL for the same branch. Each branch has its own users.
NEON_AUTH_URL=https://ep-XXXX.neonauth.REGION.aws.neon.tech/neondb/auth

ADDRESS=:9090
